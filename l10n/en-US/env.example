# HotBrief (US English edition) configuration. l10n/apply.sh en-US copies this file to .env.example.
# Then run node scripts/init-env.ts --llm-key <key>: it creates .env with fresh random secrets.
# The web front end only gets the site address; every secret stays in the backend. Never commit .env.

# ===== Required =====

# The site's public address: links, RSS, share images and MCP all use it. Keep this to try it on your machine.
SITE_URL=http://localhost:3000

# Admin password (at least 12 characters), for logging in at /admin.
ADMIN_PASSWORD=

# Secrets for signing sessions and image-proxy URLs: a random string each (openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Database password when running with Docker (the database port isn't exposed, but use a random value anyway).
POSTGRES_PASSWORD=

# Model: any OpenAI-compatible API works, and every step uses it by default. This is DeepSeek, as in the original.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Provider-specific request fields (JSON), e.g. turning thinking mode off:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Other providers (checked with OpenAI-compatible calls on 2026-10-14):
#   Google Gemini  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite  LLM_EXTRA_JSON={"reasoning_effort":"low"}
#   OpenAI         LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=<a model from your account's model list>  LLM_EXTRA_JSON={}
# Turn this on if the model can read images (headlines and summaries of top picks look at the first image):
# LLM_VISION=true
# Turn this off if the provider doesn't support JSON mode (response_format):
# LLM_JSON_MODE=false
# Extra output room for reasoning models (they think before answering and share the output budget), added to every step's own budget; 0 if unset.
# Set it when calls fail with "output token limit reached (finish_reason=length)", for example:
# LLM_REASONING_TOKENS=4000

# ===== Optional: better event grouping =====

# Vector recall: any OpenAI-compatible /embeddings API. It runs without one: grouping then finds candidates by text overlap,
# but discussion posts that only count toward heat (hot_signal sources) rarely attach to events, so heat runs low.
# Instead of the original's fallback (Alibaba Cloud DashScope), use a provider you can sign up for in the US:
#   Google Gemini (has a free tier; checked 2026-10-14):
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMS=768
#   OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Vector size (with EMBEDDING_*, empty means whatever the provider returns); changing it recomputes stored vectors:
# EMBEDDING_DIMS=
# Note: don't set DASHSCOPE_API_KEY. With only that key and no EMBEDDING_API_KEY, the engine switches to Alibaba Cloud vectors.

# ===== Optional: a different model per step =====
# By default every step uses LLM_* above. To move one step to another model, give a preset name (and its key):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Preset names and the keys they need (site/models.ts):
#   deepseek-flash / deepseek-flash-think   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   gemini-3.5-flash-lite                   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  GEMINI_API_KEY=
#   (the original's Chinese-provider presets glm-5.3-flash, qwen3.x-flash and mimo-v2.6-flash are still there)

# ===== Optional: paid collection services (billed per request, with budget breakers you adjust under admin "Settings") =====
# X (Twitter) accounts: SocialData
# SOCIALDATA_API_KEY=
# WeChat Official Accounts (China only, the original's Dajiala). Not used in the US edition; use RSS, web listing or JSON API sources.
# DAJIALA_KEY=
# Browser rendering when the article body can't be fetched: Jina Reader
# JINA_API_KEY=

# ===== Optional: Feishu / Lark =====
# The original's push, alert and login integrations are Feishu-only. Keep them off in the US (read alerts in the worker logs).
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Optional: other =====
# Raises the rate limit for JSON sources that read the GitHub API (api.github.com). A free read-only token is enough:
# GITHUB_TOKEN=
# Token for scripts that push content into the site (POST /api/ingest/items), at least 16 characters; empty turns the endpoint off.
# INGEST_TOKEN=
# Pushes per client per minute (docker compose default 10); 0 if a proxy in front already rate-limits:
# INGEST_RATE_LIMIT=10
# A proxy for fetching sources (US servers normally don't need one):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# If a source's feed or listing URL is a service you host on your private network (say RSSHub on the same Docker network), list the full host names, comma-separated (case-insensitive, no wildcards).
# Only those addresses are allowed, connected to directly without the proxy above; redirects to other hosts, article bodies and images still can't reach the private network, and link-local and cloud metadata addresses are always refused:
# PRIVATE_FEED_HOSTS=rsshub
# Cap on what the image proxy pulls from origin sites (MB per minute, GB per day); past it, uncached images get a 503:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# true when a reverse proxy such as Caddy or Nginx sits in front, so visitor addresses come from X-Forwarded-For.
# Keep false when the site faces the internet directly, so nobody can spoof an address to dodge login and feedback limits.
TRUST_PROXY=false
# MCP only accepts requests to the SITE_URL domain (and localhost); list other domains, comma-separated:
# MCP_ALLOWED_HOSTS=
# Minutes without new content before the "stopped collecting" alert; empty uses ALERTS.quietMinutes in site/site.ts (360):
# ALERT_QUIET_MINUTES=360
# Submit new pages to IndexNow (Bing and others) daily; the key is 32 hex characters you generate:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Daily database backups to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2…).
# Without DB_BACKUP_STORE_DOMAIN the address is built for Tencent COS (the original's default), so always set it outside China,
# e.g. my-bucket.s3.us-east-1.amazonaws.com for AWS S3:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Log level (default info) and database pool size (default 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Release name, shown on the admin "Runs" page and /api/health so you can confirm processes restarted after an upgrade:
# AIHOT_RELEASE=
# Environment name; defaults to production or development from NODE_ENV. Outside production it's added to alerts, and dev login works only there:
# AIHOT_ENVIRONMENT=
# Keep secrets in per-group files (models.env, collectors.env, integrations.env, auth.env) in one folder instead; values set here win:
# AIHOT_CREDENTIALS_DIR=

# ===== Safety valves =====
# Sources are fetched (including daily favicons) and models are called only when these are true; delete them or set false to stop both.
# Every *_ENABLED switch in this file accepts only true; 1, yes or TRUE count as off.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Only when running without Docker =====
# DATABASE_URL=postgres://your-user@127.0.0.1:5432/hotbrief
# API_BASE_URL=http://127.0.0.1:3001
# Folder for uploads, the image cache and local backups (default .data in the repo):
# AIHOT_DATA_DIR=/var/lib/hotbrief
# Log into the admin without a password during development (production refuses to start), and the name shown:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetching private-network addresses for local debugging (off by default; production refuses to start):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== With docker compose --profile https =====
# SITE_DOMAIN=example.com
# Port the site opens on this machine (docker compose, default 3000 on all interfaces); with HTTPS, only for the local Caddy:
# PORT=127.0.0.1:3000
# Also set TRUST_PROXY above to true.
