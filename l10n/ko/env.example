# HotBrief(한국어판) 설정. l10n/apply.sh ko 가 이 파일을 .env.example 로 복사한다.
# 그다음 node scripts/init-env.ts --llm-key <키> 를 실행하면 .env 가 만들어지고 무작위 비밀값이 채워진다.
# 웹(프런트)은 사이트 주소만 받고, 모든 비밀값은 백엔드에만 있다. .env 는 Git 에 올리지 않는다.

# ===== 필수 =====

# 사이트의 바깥 주소: 링크, RSS, 공유 이미지, MCP 가 모두 이 값을 쓴다. 내 컴퓨터에서 써 볼 때는 그대로 둔다.
SITE_URL=http://localhost:3000

# 관리자 비밀번호(12자 이상). /admin 로그인에 쓴다.
ADMIN_PASSWORD=

# 세션 서명과 이미지 프록시 서명용 비밀값. 각각 무작위 문자열(openssl rand -hex 32 로 만들 수 있다).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Docker 를 쓸 때 데이터베이스 비밀번호(DB 포트는 밖으로 열리지 않지만 무작위 값을 쓴다).
POSTGRES_PASSWORD=

# 시간대: 한국 언론사 RSS(AI타임스, 인공지능신문, 블로터 등) 상당수가 "2026-10-14 18:23:32"처럼 시간대 없는 시각을 준다.
# l10n/patches/ko.patch 를 적용하면 이런 시각을 한국 시간으로 읽는다. 패치 없이(--overlay) 쓴다면 이 아래에 "TZ" 를
# "Asia/Seoul" 로 정하는 줄을 직접 넣는다(원본 엔진은 서버 시간대로 읽어 Docker 에서는 9시간 어긋난다).

# 모델: OpenAI 호환 API 라면 무엇이든 된다. 모든 단계가 기본으로 이 모델을 쓴다. 아래는 DeepSeek 설정이다.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 서비스별 추가 요청 필드(JSON). 예: 생각(추론) 모드 끄기.
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 다른 서비스 예시(2026-10-14 에 OpenAI 호환 호출로 확인한 것):
#   Google Gemini  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite  LLM_EXTRA_JSON={"reasoning_effort":"low"}
#   OpenAI         LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=<계정의 모델 목록에서 고른 이름>  LLM_EXTRA_JSON={}
# 모델이 이미지를 볼 수 있으면 켠다(엄선 기사의 제목·요약이 첫 이미지를 참고한다):
# LLM_VISION=true
# 서비스가 JSON 모드(response_format)를 지원하지 않으면 끈다:
# LLM_JSON_MODE=false
# 추론 모델(답 전에 생각하고, 생각과 답이 출력 한도를 같이 쓴다)에 더 주는 출력 한도. 단계별 한도에 더해지고, 비우면 0.
# 호출이 "output token limit reached (finish_reason=length)"로 실패하면 설정한다. 예:
# LLM_REASONING_TOKENS=4000

# ===== 선택: 이슈 묶기를 더 정확하게 =====

# 벡터 검색: OpenAI 호환 /embeddings API 라면 무엇이든 된다. 비워도 돌아간다. 그때는 글자 겹침으로 후보를 찾는데,
# 열기 근거로만 쓰는 토론 글(hot_signal 출처)이 이슈에 잘 붙지 않아 열기가 낮게 나온다.
# 원본의 기본 대안인 알리바바 클라우드 DashScope(백련) 대신, 한국·미국에서 바로 가입되는 서비스를 쓴다:
#   Google Gemini(무료 등급 있음, 2026-10-14 확인):
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMS=768
#   OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 벡터 차원(EMBEDDING_* 를 쓸 때 비우면 서비스가 주는 값을 쓴다). 바꾸면 기존 벡터를 다시 계산한다:
# EMBEDDING_DIMS=
# 주의: DASHSCOPE_API_KEY 는 넣지 않는다. 그 키만 있고 EMBEDDING_API_KEY 가 없으면 엔진이 알리바바 클라우드 벡터로 자동 전환한다.

# ===== 선택: 단계별로 다른 모델 쓰기 =====
# 기본은 모든 단계가 위의 LLM_* 를 쓴다. 특정 단계만 다른 모델로 바꾸려면 프리셋 이름을 넣는다(해당 키가 필요하다):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 프리셋 이름과 필요한 키(site/models.ts):
#   deepseek-flash / deepseek-flash-think   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   gemini-3.5-flash-lite                   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  GEMINI_API_KEY=
#   (원본에 있던 중국 서비스 프리셋 glm-5.3-flash, qwen3.x-flash, mimo-v2.6-flash 도 그대로 남아 있다)

# ===== 선택: 유료 수집 서비스(요청마다 과금, 예산 차단기가 있고 관리자 "설정"에서 조정) =====
# X(트위터) 계정: SocialData
# SOCIALDATA_API_KEY=
# 위챗 공식계정(중국 전용, 원본의 Dajiala). 한국·미국판에서는 쓰지 않는다. 대신 RSS·웹 목록·JSON API 출처를 쓴다.
# DAJIALA_KEY=
# 본문을 못 가져올 때 브라우저 렌더링으로 보완: Jina Reader
# JINA_API_KEY=

# ===== 선택: 페이수(Feishu/Lark) =====
# 원본의 알림·로그인 연동은 페이수 전용이다. 한국에서는 보통 쓰지 않으니 꺼 둔다(경보는 worker 로그로 본다).
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 선택: 그 밖 =====
# GitHub API(api.github.com)를 읽는 JSON 출처에 붙이면 호출 한도가 늘어난다. 읽기 권한만 있는 무료 토큰이면 된다:
# GITHUB_TOKEN=
# 외부 스크립트가 사이트에 글을 밀어 넣을 때(POST /api/ingest/items) 쓰는 토큰, 16자 이상. 비우면 이 API 를 끈다.
# INGEST_TOKEN=
# 밀어 넣기 API 의 클라이언트별 분당 횟수(docker compose 기본 10). 앞단 프록시가 이미 제한하면 0:
# INGEST_RATE_LIMIT=10
# 출처를 프록시로 가져와야 할 때(한국·미국 서버는 보통 필요 없다):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 출처 구독·목록 주소가 내부망에 직접 띄운 서비스(예: 같은 Docker 네트워크의 RSSHub)이면 전체 호스트 이름을 쉼표로 적습니다(대소문자 무시, 와일드카드 없음).
# 이 주소만 허용하고 위 프록시를 거치지 않고 바로 연결합니다. 다른 호스트로의 리디렉션, 기사 본문, 이미지는 여전히 내부망에 연결할 수 없고, 링크 로컬과 클라우드 메타데이터 주소는 항상 거부합니다:
# PRIVATE_FEED_HOSTS=rsshub
# 이미지 프록시가 원본 사이트에서 가져오는 양의 상한(분당 MB, 일당 GB). 넘으면 캐시 없는 이미지는 503:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# 앞에 Caddy·Nginx 같은 리버스 프록시가 있으면 true. 그래야 방문자 주소를 X-Forwarded-For 에서 읽는다.
# 사이트가 직접 인터넷에 노출되면 false 로 둔다(주소를 위조해 로그인 횟수·의견 제한을 우회하지 못하게).
TRUST_PROXY=false
# MCP 는 SITE_URL 도메인(과 localhost)으로 온 요청만 받는다. 다른 접속 도메인이 있으면 쉼표로 적는다:
# MCP_ALLOWED_HOSTS=
# 새 글이 몇 분 동안 안 들어오면 "수집 멈춤" 경보를 낼지. 비우면 site/site.ts 의 ALERTS.quietMinutes(기본 360):
# ALERT_QUIET_MINUTES=360
# 매일 새 페이지를 IndexNow(Bing, 네이버 등)에 알린다. key 는 32자리 16진수를 직접 만든다:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 데이터베이스를 매일 S3 호환 저장소(AWS S3, Cloudflare R2, 네이버클라우드 Object Storage……)에 백업한다.
# DB_BACKUP_STORE_DOMAIN 을 비우면 원본 기본값인 텐센트 COS 주소로 만든다. 한국·미국에서는 버킷 이름이 든 접속 도메인을 꼭 적는다.
# 예: AWS S3 는 my-bucket.s3.ap-northeast-2.amazonaws.com
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 로그 수준(기본 info)과 DB 연결 풀 상한(기본 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# 버전 이름: 관리자 "실행" 페이지와 /api/health 에 보인다. 업그레이드 뒤 프로세스가 바뀌었는지 확인할 때 쓴다:
# AIHOT_RELEASE=
# 환경 이름. 기본은 NODE_ENV 에 따라 production 또는 development. production 이 아니면 경보에 붙고, 개발용 무로그인도 이때만 된다:
# AIHOT_ENVIRONMENT=
# 비밀값을 그룹별 파일(models.env, collectors.env, integrations.env, auth.env)로 한 폴더에 둘 때. 여기 적은 값이 우선:
# AIHOT_CREDENTIALS_DIR=

# ===== 안전 밸브 =====
# true 일 때만 출처를 가져오고(출처 아이콘 포함) 모델을 부른다. 지우거나 false 면 모두 멈춘다(화면만 고칠 때 편하다).
# 이 파일의 *_ENABLED 스위치는 모두 true 만 인정한다. 1, yes, TRUE 는 꺼짐으로 본다.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Docker 없이 직접 돌릴 때만 =====
# DATABASE_URL=postgres://사용자명@127.0.0.1:5432/hotbrief
# API_BASE_URL=http://127.0.0.1:3001
# 업로드 파일, 이미지 캐시, 로컬 백업 폴더(기본은 저장소 안 .data):
# AIHOT_DATA_DIR=/var/lib/hotbrief
# 개발 중 로그인 없이 관리자 화면 들어가기(운영 환경에서는 시작을 거부한다)와 화면에 보일 이름:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# 로컬 디버깅 때 내부망 주소 가져오기 허용(기본 금지, 운영 환경에서는 시작 거부):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== docker compose --profile https 를 쓸 때 =====
# SITE_DOMAIN=example.com
# 사이트가 이 컴퓨터에서 여는 포트(docker compose 용, 기본 3000, 모든 네트워크에 열림). HTTPS 를 쓰면 이 컴퓨터의 Caddy 만 쓰게 한다:
# PORT=127.0.0.1:3000
# 그리고 위의 TRUST_PROXY 를 true 로 바꾼다.
